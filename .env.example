# NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=

# Must support OpenAI-style tool calling. Verify at startup with the self-test.
# Verified working on 2026-11-10 (tool call in ~2.5 s).
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional overrides
# WHISPER_MODEL=tiny.en
# WHISPER_CPU_THREADS=2
# PTT_KEY=f9
# AUDIO_OUTPUT_DEVICE=pipewire
# AUDIO_INPUT_DEVICE=pipewire
# PIPER_BIN=piper
# LLM_TIMEOUT_S=30
# LLM_SELF_TEST_TIMEOUT_S=20
# DEBUG=1
